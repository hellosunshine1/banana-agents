# Copy to .env for docker compose (repo root).
# Local backend-only dev can instead use backend/.env (see backend/.env.example).

# Database
# Compose overrides host to `db` via docker-compose.yml environment.
# For local uvicorn against compose db, use localhost:
# DATABASE_URL=postgresql+asyncpg://banana:banana@localhost:5432/banana
DATABASE_URL=postgresql+asyncpg://banana:banana@db:5432/banana
EMBEDDING_DIM=1536

# Auth
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Generation: auto | dify | langchain
# auto: use Dify when API key + workflow configured, else OpenAI-compatible LLM from Settings
GENERATION_BACKEND=auto

# Dify（本地/内网外挂，不在本 Compose 内）
DIFY_BASE_URL=http://host.docker.internal/v1
DIFY_API_KEY=
DIFY_WF_ARCHITECTURE=
DIFY_WF_BLUEPRINT=
DIFY_WF_CHAPTER_DRAFT=
DIFY_WF_FINALIZE_SUMMARY=
DIFY_WF_CONSISTENCY_REVIEW=

# Jobs
JOB_TIMEOUT_SEC=600
JOB_MAX_CONCURRENCY=2

# CORS (JSON list). Needed if calling API :8000 directly from a browser origin.
# Same-origin via web nginx (http://127.0.0.1:8080) does not require CORS for /api.
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
