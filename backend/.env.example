# Database
DATABASE_URL=postgresql+asyncpg://banana:banana@localhost:5432/banana
EMBEDDING_DIM=1536

# Auth
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Generation: auto | dify | langchain
# auto: use Dify when API key + workflow configured, else OpenAI-compatible LLM from Settings
GENERATION_BACKEND=auto

# Dify（本地部署）
DIFY_BASE_URL=http://localhost/v1
DIFY_API_KEY=
DIFY_WF_ARCHITECTURE=
DIFY_WF_BLUEPRINT=
DIFY_WF_CHAPTER_DRAFT=
DIFY_WF_FINALIZE_SUMMARY=
DIFY_WF_CONSISTENCY_REVIEW=

# Jobs
JOB_TIMEOUT_SEC=600
JOB_MAX_CONCURRENCY=2

# CORS (JSON list); Compose web UI defaults include :8080
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
